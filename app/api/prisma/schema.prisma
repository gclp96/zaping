  lifecycle                HealthcareCaseDispatchItemLifecycle @default(ACTIVE)
  productId                String
  addedById                String
  createdAt                DateTime                            @default(now())
  excludedById             String?
  excludedAt               DateTime?
  exclusionReason          String?                             @db.VarChar(1000)
  snapshot                 Json?                               @db.JsonB
  quantity                 Int?
  batchId                  String?
  sourcePositionId         String?
  expectedPositionRevision Int?
  destinationPositionId    String?
  physicalEffectId         String?
  assignmentId             String?
  assetId                  String?
  expectedPhysicalRevision Int?
  equipmentCustodyId       String?                             @unique
  equipmentPhysicalEventId String?                             @unique
  dispatch                 HealthcareCaseDispatch              @relation(fields: [dispatchId, companyId, caseId, caseKitId], references: [id, companyId, caseId, caseKitId], onDelete: Restrict, onUpdate: Restrict)
  sourceCaseKitItem        HealthcareCaseKitItem               @relation(fields: [sourceCaseKitItemId, companyId, caseId, caseKitId], references: [id, companyId, caseId, caseKitId], onDelete: Restrict, onUpdate: Restrict)
  product                  Product                             @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  batch                    InventoryBatch?                     @relation(fields: [batchId, companyId, productId], references: [id, companyId, productId], onDelete: Restrict, onUpdate: Restrict)
  sourcePosition           InventoryPosition?                  @relation("DispatchSourcePosition", fields: [sourcePositionId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  destinationPosition      InventoryPosition?                  @relation("DispatchDestinationPosition", fields: [destinationPositionId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  physicalEffect           InventoryPhysicalEffect?            @relation(fields: [physicalEffectId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  assignment               HealthcareEquipmentAssignment?      @relation(fields: [assignmentId, companyId, caseId, assetId], references: [id, companyId, caseId, equipmentAssetId], onDelete: Restrict, onUpdate: Restrict)
  asset                    EquipmentAsset?                     @relation(fields: [assetId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  equipmentCustody         EquipmentAssetCustody?              @relation(fields: [equipmentCustodyId, companyId, assetId], references: [id, companyId, equipmentAssetId], onDelete: Restrict, onUpdate: Restrict)
  equipmentPhysicalEvent   EquipmentAssetPhysicalEvent?        @relation(fields: [equipmentPhysicalEventId, companyId, assetId], references: [id, companyId, equipmentAssetId], onDelete: Restrict, onUpdate: Restrict)
  addedBy                  User                                @relation("DispatchItemAddedBy", fields: [addedById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  excludedBy               User?                               @relation("DispatchItemExcludedBy", fields: [excludedById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  audit                    HealthcareCaseDispatchAudit[]

  @@unique([id, companyId])
  @@unique([id, companyId, dispatchId], map: "HealthcareCaseDispatchItem_audit_parent_key")
  @@index([companyId, dispatchId, createdAt, id])
  @@index([companyId, sourceCaseKitItemId, lifecycle])
}

model HealthcareCaseDispatchAudit {
  id             String                               @id @default(uuid())
  companyId      String
  dispatchId     String
