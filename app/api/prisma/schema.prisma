generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id String @id @default(uuid())

  companyId   String
  description String?
  name        String
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  products Product[]

  @@unique([companyId, name])
}

model Product {
  dispatchItems HealthcareCaseDispatchItem[]

  inventoryCutoverProducts InventoryCutoverProduct[]

  id          String  @id @default(uuid())
  companyId   String
  sku         String
  name        String
  description String?
  brand       String?
  categoryId  String?

  category                   Category?                   @relation(fields: [categoryId], references: [id])
  barcode                    String?
  cost                       Float                       @default(0)
  price                      Float                       @default(0)
  stock                      Int                         @default(0)
  minStock                   Int                         @default(0)
  isActive                   Boolean                     @default(true)
  inventoryTracking          ProductInventoryTracking    @default(QUANTITY)
  lotTracking                ProductLotTracking          @default(OPTIONAL)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  inventoryMovements         InventoryMovement[]
  inventoryBatches           InventoryBatch[]
  inventoryPositions         InventoryPosition[]
  purchaseReceiptItems       PurchaseReceiptItem[]
  equipmentAssets            EquipmentAsset[]
  healthcareCaseRequirements HealthcareCaseRequirement[]
  company                    Company                     @relation(fields: [companyId], references: [id])
  purchaseItems              PurchaseItem[]
  quoteItems                 QuoteItem[]
  saleItems                  SaleItem[]

  @@unique([id, companyId])
  @@unique([companyId, sku])
  @@unique([companyId, barcode])
}

model InventoryMovement {
  id            String                @id @default(uuid())
  companyId     String
  productId     String
  batchId       String?
  movementType  InventoryMovementType
  quantity      Int
  balance       Int?
  referenceType String?
  referenceId   String?
  notes         String?
  createdBy     String?
  unitCost      Float?
  createdAt     DateTime              @default(now())

  company Company         @relation(fields: [companyId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  batch   InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([companyId])
  @@index([productId])
  @@index([batchId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model InventoryBatch {
  dispatchItems HealthcareCaseDispatchItem[]

  id        String @id @default(uuid())
  companyId String
  productId String

  lotNumber      String
  expirationDate DateTime?

  initialQuantity   Int   @default(0)
  availableQuantity Int   @default(0)
  unitCost          Float @default(0)

  receivedAt DateTime @default(now())
  notes      String?
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  receiptItems       PurchaseReceiptItem[]
  movements          InventoryMovement[]
  equipmentAssets    EquipmentAsset[]
  inventoryPositions InventoryPosition[]

  @@unique([id, companyId])
  @@unique([id, companyId, productId])
  @@unique([companyId, productId, lotNumber])
  @@index([companyId])
  @@index([productId])
  @@index([expirationDate])
  @@index([isActive])
}

// Dormant physical authority; no productive writers/readers until later slices.
enum InventoryPositionState {
  AVAILABLE
  CUSTODY
}

enum InventoryPhysicalEffectKind {
  OPENING
  CREDIT
  TRANSFER
  DEFINITIVE_OUT
  COUNT_CORRECTION
}

model InventoryPosition {
  correctionSources      HealthcareCaseDispatchCorrectionItem[] @relation("CorrectionSourcePosition")
  correctionDestinations HealthcareCaseDispatchCorrectionItem[] @relation("CorrectionDestinationPosition")

  reconciliationSources      HealthcareCaseReconciliationItem[] @relation("ReconciliationSourcePosition")
  reconciliationDestinations HealthcareCaseReconciliationItem[] @relation("ReconciliationDestinationPosition")

  dispatchSources      HealthcareCaseDispatchItem[] @relation("DispatchSourcePosition")
  dispatchDestinations HealthcareCaseDispatchItem[] @relation("DispatchDestinationPosition")

  id               String                        @id @default(uuid())
  companyId        String
  productId        String
  inventoryBatchId String?
  // Only for unbatched physical stock; batches own their own expiration.
  expirationDate   DateTime? @db.Date
  state            InventoryPositionState
  contextType      String?                       @db.VarChar(64)
  contextId        String?                       @db.VarChar(128)
  quantity         Int                           @default(0)
  revision         Int                           @default(0)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  company          Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product          Product                       @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  batch            InventoryBatch?               @relation(fields: [inventoryBatchId, companyId, productId], references: [id, companyId, productId], onDelete: Restrict, onUpdate: Restrict)
  lines            InventoryPhysicalEffectLine[]
  // Four partial UNIQUE indexes and CHECKs are maintained in migration SQL.

  @@unique([id, companyId])
  @@index([companyId, productId, state])
  @@index([companyId, inventoryBatchId, state])
  @@index([companyId, contextType, contextId])
}

model InventoryPhysicalEffect {
  correctionOriginalItems     HealthcareCaseDispatchCorrectionItem[] @relation("CorrectionOriginalEffect")
  correctionCompensatingItems HealthcareCaseDispatchCorrectionItem[] @relation("CorrectionCompensatingEffect")

  reconciliationReturns HealthcareCaseReconciliationItem[] @relation("ReconciliationReturnedEffect")
  reconciliationUses    HealthcareCaseReconciliationItem[] @relation("ReconciliationUsedEffect")

  dispatchItems HealthcareCaseDispatchItem[]

  openingCutoverProduct InventoryCutoverProduct? @relation("CutoverProductOpeningEffect")

  id              String                        @id @default(uuid())
  companyId       String
  originType      String                        @db.VarChar(64)
  originId        String                        @db.VarChar(128)
  originOperation String                        @db.VarChar(64)
  kind            InventoryPhysicalEffectKind
  requestHash     String                        @db.Char(64)
  lineCount       Int
  actorId         String
  reason          String?                       @db.VarChar(1000)
  occurredAt      DateTime                      @default(now())
  createdAt       DateTime                      @default(now())
  company         Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor           User                          @relation(fields: [actorId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  lines           InventoryPhysicalEffectLine[]

  @@unique([id, companyId])
  @@unique([companyId, originType, originId, originOperation], map: "InventoryPhysicalEffect_origin_key")
  @@index([companyId, occurredAt, id])
}

model InventoryPhysicalEffectLine {
  id             String                  @id @default(uuid())
  companyId      String
  effectId       String
  positionId     String
  sequence       Int
  delta          Int
  quantityBefore Int
  quantityAfter  Int
  revisionBefore Int
  revisionAfter  Int
  effect         InventoryPhysicalEffect @relation(fields: [effectId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  position       InventoryPosition       @relation(fields: [positionId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([effectId, sequence])
  @@unique([effectId, positionId])
  @@index([companyId, positionId, effectId])
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum ProductInventoryTracking {
  QUANTITY
  SERIALIZED
  ASSET
}

enum ProductLotTracking {
  NONE
  OPTIONAL
  REQUIRED
}

enum IdempotencyScope {
  HEALTHCARE_CASE_DISPATCH_CORRECTION_NO_HANDOFF
  HEALTHCARE_CASE_RECONCILIATION_CREATE
  HEALTHCARE_CASE_RECONCILIATION_ITEM_ADD
  HEALTHCARE_CASE_RECONCILIATION_OUTCOME_SET
  HEALTHCARE_CASE_RECONCILIATION_ITEM_EXCLUDE
  HEALTHCARE_CASE_RECONCILIATION_CONFIRM
  HEALTHCARE_CASE_RECONCILIATION_CANCEL
  HEALTHCARE_CASE_DISPATCH_CREATE
  HEALTHCARE_CASE_DISPATCH_CUSTODIAN_SET
  HEALTHCARE_CASE_DISPATCH_ITEM_ADD
  HEALTHCARE_CASE_DISPATCH_ITEM_EXCLUDE
  HEALTHCARE_CASE_DISPATCH_CONFIRM
  HEALTHCARE_CASE_DISPATCH_CANCEL
  INVENTORY_MANUAL_PHYSICAL_MUTATION
  PURCHASE_RECEIPT_CREATE
  SUPPLIER_DOCUMENT_CREATE
  SUPPLIER_DOCUMENT_EXCEPTION_CREATE
  SUPPLIER_DOCUMENT_BASIS_CONFIRM
  SUPPLIER_DOCUMENT_ALLOCATION_CREATE
  SUPPLIER_DOCUMENT_ALLOCATION_REVISE
  SUPPLIER_DOCUMENT_CORRECT
  SUPPLIER_DOCUMENT_CANCEL
  SUPPLIER_DOCUMENT_VARIANCE_APPROVE
  HEALTHCARE_EQUIPMENT_ASSIGNMENT_CREATE
  HEALTHCARE_EQUIPMENT_ASSIGNMENT_REPLACE
  HEALTHCARE_EQUIPMENT_COVERAGE_NOTE_CREATE
  HEALTHCARE_EQUIPMENT_COVERAGE_NOTE_RESOLVE
  HEALTHCARE_EQUIPMENT_ASSIGNMENT_RELEASE
  HEALTHCARE_CASE_KIT_CREATE
  HEALTHCARE_CASE_KIT_ITEM_ADD
  HEALTHCARE_CASE_KIT_ITEM_EXCLUDE
  HEALTHCARE_CASE_KIT_CONFIRM_PREPARATION
}

enum EquipmentPhysicalLocation {
  UNVERIFIED
  WAREHOUSE
  CUSTODY
}

enum EquipmentPhysicalOperation {
  BASELINE_RECONCILIATION
  RECEIPT_INITIALIZATION
  CUSTODY_OPEN
  CUSTODY_CLOSE
  CONDITION_CHANGE
  LIFECYCLE_CHANGE
}

enum EquipmentLifecycle {
  ACTIVE
  RETIRED
}

enum EquipmentCondition {
  GOOD
  INSPECTION_PENDING
  DAMAGED
  OUT_OF_SERVICE
}

enum EquipmentOrigin {
  MANUAL
  PURCHASE_RECEIPT
  IMPORT
  INITIAL_MIGRATION
}

enum EquipmentRetirementReason {
  SOLD
  LOST
  DESTROYED
  END_OF_LIFE
  REPLACED
  OTHER
}

model Customer {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  type        String?
  email       String?
  phone       String?
  address     String?
  contactName String?
  creditLimit Decimal?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company @relation(fields: [companyId], references: [id])
  quotes   Quote[]
  sales    Sale[]
  isActive Boolean @default(true)

  @@index([companyId])
}

enum DocumentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Quote {
  inventoryCutoverLegacySales InventoryCutoverLegacySale[]

  id              String         @id @default(uuid())
  companyId       String
  customerId      String
  folio           String
  subtotal        Float
  iva             Float
  total           Float
  status          DocumentStatus @default(DRAFT)
  convertedToSale Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company  Company     @relation(fields: [companyId], references: [id])
  customer Customer    @relation(fields: [customerId], references: [id])
  items    QuoteItem[]

  sale Sale?

  @@unique([id, companyId])
}

model QuoteItem {
  id        String  @id @default(uuid())
  quoteId   String
  productId String
  quantity  Int
  price     Float
  subtotal  Float
  product   Product @relation(fields: [productId], references: [id])
  quote     Quote   @relation(fields: [quoteId], references: [id])
}

model Purchase {
  id         String @id @default(uuid())
  companyId  String
  folio      String
  supplierId String

  supplier Supplier @relation(fields: [supplierId], references: [id])

  subtotal Float
  iva      Float
  total    Float

  status    PurchaseStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company  Company           @relation(fields: [companyId], references: [id])
  items    PurchaseItem[]
  receipts PurchaseReceipt[]
  supplierDocumentAllocations PurchaseReceiptDocument[]
  supplierDocumentApprovals PurchaseReceiptReconciliationApproval[]
  documentLinks PurchaseReceiptSupplierDocumentLink[]

  @@unique([id, companyId, supplierId])
  @@unique([companyId, folio])
  @@index([companyId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseItem {
  id         String @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Int
  price      Float
  subtotal   Float

  product  Product  @relation(fields: [productId], references: [id])
  purchase Purchase @relation(fields: [purchaseId], references: [id])

  receiptItems PurchaseReceiptItem[]

  @@index([purchaseId])
  @@index([productId])
}

model PurchaseReceipt {
  id         String   @id @default(uuid())
  companyId  String
  purchaseId String
  folio      String
  receivedAt DateTime @default(now())
  receivedBy             String?
  notes                  String?
  supplierDocumentType   String?
  supplierDocumentNumber String?
  createdAt              DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  purchase Purchase @relation(fields: [purchaseId], references: [id])

  receivedByUser User? @relation("PurchaseReceiptReceivedBy", fields: [receivedBy], references: [id], onDelete: SetNull)

  items PurchaseReceiptItem[]
  supplierDocumentAllocations PurchaseReceiptDocument[]
  supplierDocumentApprovals PurchaseReceiptReconciliationApproval[]
  documentLinks PurchaseReceiptSupplierDocumentLink[]

  @@unique([id, companyId])
  @@unique([id, companyId, purchaseId])
  @@unique([companyId, folio])
  @@index([companyId])
  @@index([purchaseId])
  @@index([receivedBy])
  @@index([receivedAt])
}

model PurchaseReceiptItem {
  id               String    @id @default(uuid())
  companyId        String
  receiptId        String
  purchaseItemId   String
  productId        String
  quantityReceived Int
  lotNumber        String?
  expirationDate   DateTime?
  unitCost         Float
  batchId          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company      Company         @relation(fields: [companyId], references: [id])
  receipt      PurchaseReceipt @relation(fields: [receiptId], references: [id])
  purchaseItem PurchaseItem    @relation(fields: [purchaseItemId], references: [id])
  product      Product         @relation(fields: [productId], references: [id])
  batch        InventoryBatch? @relation(fields: [batchId], references: [id])

  equipmentAssets EquipmentAsset[]

  @@index([companyId])
  @@index([receiptId])
  @@index([purchaseItemId])
  @@index([productId])
  @@index([lotNumber])
  @@index([expirationDate])
}

model Company {
  dispatchCorrections HealthcareCaseDispatchCorrection[]

  caseReconciliations HealthcareCaseReconciliation[]

  caseDispatches HealthcareCaseDispatch[]

  equipmentAssetCustodies      EquipmentAssetCustody[]
  equipmentAssetPhysicalEvents EquipmentAssetPhysicalEvent[]

  inventoryCutover InventoryCutover?

  id                                    String                                          @id @default(uuid())
  name                                  String
  tradeName                             String?
  rfc                                   String                                          @unique
  email                                 String?
  phone                                 String?
  language                              String                                          @default("es")
  timezone                              String                                          @default("America/Hermosillo")
  createdAt                             DateTime                                        @default(now())
  updatedAt                             DateTime                                        @updatedAt
  customers                             Customer[]
  healthcareCases                       HealthcareCase[]
  healthcareDoctors                     HealthcareDoctor[]
  healthcareHospitals                   HealthcareHospital[]
  healthcareDoctorHospitalAffiliations  HealthcareDoctorHospitalAffiliation[]
  healthcareCaseRequirements            HealthcareCaseRequirement[]
  healthcareEquipmentAssignments        HealthcareEquipmentAssignment[]
  healthcareEquipmentConflictOverrides  HealthcareEquipmentAssignmentConflictOverride[]
  healthcareEquipmentCoverageNotes      HealthcareEquipmentRequirementCoverageNote[]
  healthcareEquipmentAssignmentSettings HealthcareEquipmentAssignmentSettings?
  healthcareCaseKits                    HealthcareCaseKit[]
  inventoryMovements                    InventoryMovement[]
  inventoryBatches                      InventoryBatch[]
  inventoryPositions                    InventoryPosition[]
  inventoryPhysicalEffects              InventoryPhysicalEffect[]
  equipmentAssets                       EquipmentAsset[]
  equipmentInspections                  EquipmentInspection[]
  companySequences                      CompanySequence[]
  idempotencyRecords                    IdempotencyRecord[]
  supplierDocuments                     SupplierDocument[]
  supplierDocumentAttachments           SupplierDocumentAttachment[]
  supplierAttachmentUploadReservations   SupplierAttachmentUploadReservation[]
  supplierAttachmentReconcileEvents      SupplierAttachmentReconcileEvent[]
  supplierDocumentAllocations           PurchaseReceiptDocument[]
  supplierDocumentApprovals             PurchaseReceiptReconciliationApproval[]
  receiptDocumentLinks                  PurchaseReceiptSupplierDocumentLink[]
  purchaseReceipts                      PurchaseReceipt[]
  purchaseReceiptItems                  PurchaseReceiptItem[]
  products                              Product[]
  purchases                             Purchase[]
  quotes                                Quote[]
  users                                 User[]

  sales Sale[]

  suppliers  Supplier[]
  categories Category[]
  currency   String     @default("MXN")
}

model CompanySequence {
  id        String @id @default(uuid())
  companyId String

  key       String
  nextValue Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, key])
}

model IdempotencyRecord {
  dispatchCorrection HealthcareCaseDispatchCorrection?
  id                 String                            @id @default(uuid())
  companyId          String
  scope              IdempotencyScope
  key                String
  requestHash        String
  resourceId         String?
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, scope, key])
  @@unique([id, companyId], map: "IdempotencyRecord_correction_identity_key")
}

enum HealthcareCaseStatus {
  DRAFT
  SCHEDULED
  CANCELLED
}

enum HealthcareRequirementType {
  REQUIRED
  BACKUP
}

enum HealthcareRequirementLifecycle {
  ACTIVE
  RETIRED
}

enum HealthcareEquipmentAssignmentOrigin {
  REQUIREMENT
  DIRECT
}

enum HealthcareEquipmentAssignmentLifecycle {
  RESERVED
  RELEASED
  REPLACED
}

enum HealthcareEquipmentAssignmentReleaseCause {
  MANUAL
  CASE_CANCELLED
  REQUIREMENT_WITHDRAWN
}

enum HealthcareEquipmentRequirementCoverageNoteKind {
  UNAVAILABLE
  PARTIAL_CONTEXT
}

enum HealthcareCaseKitStatus {
  DRAFT
  PREPARED
}

enum HealthcareCaseKitItemLifecycle {
  ACTIVE
  EXCLUDED
}

model User {
  dispatchCorrectionsConfirmed HealthcareCaseDispatchCorrection[] @relation("DispatchCorrectionActor")

  createdReconciliations      HealthcareCaseReconciliation[]      @relation("ReconciliationCreatedBy")
  confirmedReconciliations    HealthcareCaseReconciliation[]      @relation("ReconciliationConfirmedBy")
  cancelledReconciliations    HealthcareCaseReconciliation[]      @relation("ReconciliationCancelledBy")
  createdReconciliationItems  HealthcareCaseReconciliationItem[]  @relation("ReconciliationItemCreatedBy")
  excludedReconciliationItems HealthcareCaseReconciliationItem[]  @relation("ReconciliationItemExcludedBy")
  reconciliationAudits        HealthcareCaseReconciliationAudit[]

  createdDispatches     HealthcareCaseDispatch[]      @relation("DispatchCreatedBy")
  confirmedDispatches   HealthcareCaseDispatch[]      @relation("DispatchConfirmedBy")
  cancelledDispatches   HealthcareCaseDispatch[]      @relation("DispatchCancelledBy")
  custodianDispatches   HealthcareCaseDispatch[]      @relation("DispatchCustodian")
  addedDispatchItems    HealthcareCaseDispatchItem[]  @relation("DispatchItemAddedBy")
  excludedDispatchItems HealthcareCaseDispatchItem[]  @relation("DispatchItemExcludedBy")
  dispatchAudits        HealthcareCaseDispatchAudit[]

  openedEquipmentCustodies     EquipmentAssetCustody[]       @relation("EquipmentCustodyOpenedBy")
  closedEquipmentCustodies     EquipmentAssetCustody[]       @relation("EquipmentCustodyClosedBy")
  equipmentAssetPhysicalEvents EquipmentAssetPhysicalEvent[] @relation("EquipmentPhysicalEventActor")

  initiatedInventoryCutovers InventoryCutover[] @relation("InventoryCutoverInitiator")
  approvedInventoryCutovers  InventoryCutover[] @relation("InventoryCutoverApprover")
  activatedInventoryCutovers InventoryCutover[] @relation("InventoryCutoverActivator")

  id           String   @id @default(uuid())
  companyId    String
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  authVersion  Int      @default(0)
  locale       String   @default("es")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         UserRole

  company Company @relation(fields: [companyId], references: [id])

  receivedPurchaseReceipts PurchaseReceipt[] @relation("PurchaseReceiptReceivedBy")
  supplierDocumentsCreated SupplierDocument[] @relation("SupplierDocumentCreatedBy")
  supplierAttachmentUploaders SupplierDocumentAttachment[] @relation("SupplierAttachmentUploadedBy")
  supplierAttachmentRemovers SupplierDocumentAttachment[] @relation("SupplierAttachmentRemovedBy")
  supplierDocumentExceptionsReviewed SupplierDocument[] @relation("SupplierDocumentExceptionReviewer")
  supplierDocumentAuditActions SupplierDocumentAudit[] @relation("SupplierDocumentAuditActor")
  supplierAttachmentUploadReservations SupplierAttachmentUploadReservation[] @relation("SupplierAttachmentUploadReservationActor")
  supplierDocumentAllocationCreators PurchaseReceiptDocument[] @relation("SupplierDocumentAllocationCreator")
  supplierDocumentCancellationActors SupplierDocument[] @relation("SupplierDocumentCancelledBy")
  supplierDocumentApprovalActors PurchaseReceiptReconciliationApproval[] @relation("SupplierDocumentApprovalActor")
  receiptDocumentLinkCreators PurchaseReceiptSupplierDocumentLink[] @relation("ReceiptDocumentLinkCreatedBy")
  receiptDocumentLinkRemovers PurchaseReceiptSupplierDocumentLink[] @relation("ReceiptDocumentLinkRemovedBy")

  equipmentInspections EquipmentInspection[] @relation("EquipmentInspectedBy")
  retiredEquipment     EquipmentAsset[]      @relation("EquipmentRetiredBy")

  responsibleHealthcareCases HealthcareCase[] @relation("HealthcareCaseResponsibleUser")
  createdHealthcareCases     HealthcareCase[] @relation("HealthcareCaseCreatedBy")
  cancelledHealthcareCases   HealthcareCase[] @relation("HealthcareCaseCancelledBy")

  createdHealthcareCaseRequirements     HealthcareCaseRequirement[] @relation("HealthcareRequirementCreatedBy")
  retiredHealthcareCaseRequirements     HealthcareCaseRequirement[] @relation("HealthcareRequirementRetiredBy")
  reactivatedHealthcareCaseRequirements HealthcareCaseRequirement[] @relation("HealthcareRequirementReactivatedBy")

  createdHealthcareEquipmentAssignments  HealthcareEquipmentAssignment[]                 @relation("HealthcareEquipmentAssignmentCreatedBy")
  releasedHealthcareEquipmentAssignments HealthcareEquipmentAssignment[]                 @relation("HealthcareEquipmentAssignmentReleasedBy")
  replacedHealthcareEquipmentAssignments HealthcareEquipmentAssignment[]                 @relation("HealthcareEquipmentAssignmentReplacedBy")
  approvedHealthcareEquipmentOverrides   HealthcareEquipmentAssignmentConflictOverride[] @relation("HealthcareEquipmentAssignmentOverrideApprovedBy")
  recordedHealthcareEquipmentNotes       HealthcareEquipmentRequirementCoverageNote[]    @relation("HealthcareEquipmentCoverageNoteRecordedBy")
  resolvedHealthcareEquipmentNotes       HealthcareEquipmentRequirementCoverageNote[]    @relation("HealthcareEquipmentCoverageNoteResolvedBy")
  createdHealthcareCaseKits              HealthcareCaseKit[]                             @relation("HealthcareCaseKitCreatedBy")
  preparedHealthcareCaseKits             HealthcareCaseKit[]                             @relation("HealthcareCaseKitPreparedBy")
  addedHealthcareCaseKitItems            HealthcareCaseKitItem[]                         @relation("HealthcareCaseKitItemAddedBy")
  excludedHealthcareCaseKitItems         HealthcareCaseKitItem[]                         @relation("HealthcareCaseKitItemExcludedBy")

  createdSaleReturns   SaleReturn[] @relation("SaleReturnCreatedBy")
  confirmedSaleReturns SaleReturn[] @relation("SaleReturnConfirmedBy")
  cancelledSaleReturns SaleReturn[] @relation("SaleReturnCancelledBy")

  passwordResetTokens      PasswordResetToken[]
  inventoryPhysicalEffects InventoryPhysicalEffect[]

  @@unique([id, companyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model HealthcareDoctor {
  id        String @id @default(uuid())
  companyId String

  firstName String
  lastName  String
  specialty String

  phone String?
  email String?
  notes String?

  searchKey String
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  affiliations HealthcareDoctorHospitalAffiliation[]
  cases        HealthcareCase[]                      @relation("HealthcareCaseDoctor")

  @@unique([id, companyId])
  @@index([companyId, isActive, lastName, firstName])
  @@index([companyId, searchKey])
}

model HealthcareHospital {
  id        String @id @default(uuid())
  companyId String

  name  String
  city  String
  state String

  address     String?
  phone       String?
  email       String?
  contactName String?
  notes       String?

  searchKey String
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  affiliations HealthcareDoctorHospitalAffiliation[]
  cases        HealthcareCase[]                      @relation("HealthcareCaseHospital")

  @@unique([id, companyId])
  @@index([companyId, isActive, name])
  @@index([companyId, state, city])
  @@index([companyId, searchKey])
}

model HealthcareDoctorHospitalAffiliation {
  id         String @id @default(uuid())
  companyId  String
  doctorId   String
  hospitalId String

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
