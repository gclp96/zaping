  companyId                     String
  reconciliationId              String
  caseId                        String
  dispatchId                    String
  sourceDispatchItemId          String
  type                          HealthcareCaseReconciliationItemType
  lifecycle                     HealthcareCaseReconciliationItemLifecycle     @default(ACTIVE)
  createdById                   String
  createdAt                     DateTime                                      @default(now())
  excludedById                  String?
  excludedAt                    DateTime?
