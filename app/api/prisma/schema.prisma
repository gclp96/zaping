  usedQty                       Int?
  returnedDestinationPositionId String?
  returnedPhysicalEffectId      String?
  usedPhysicalEffectId          String?
  equipmentCustodyId            String?
  assetId                       String?
  assignmentId                  String?
  expectedPhysicalRevision      Int?
  outcome                       HealthcareCaseReconciliationEquipmentOutcome?
  reportedCondition             EquipmentCondition?
  closePhysicalEventId          String?
  reconciliation                HealthcareCaseReconciliation                  @relation(fields: [reconciliationId, companyId, caseId, dispatchId], references: [id, companyId, caseId, dispatchId], onDelete: Restrict, onUpdate: Restrict)
  sourceDispatchItem            HealthcareCaseDispatchItem                    @relation(fields: [sourceDispatchItemId, companyId, dispatchId], references: [id, companyId, dispatchId], onDelete: Restrict, onUpdate: Restrict)
  sourceCustodyPosition         InventoryPosition?                            @relation("ReconciliationSourcePosition", fields: [sourceCustodyPositionId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  returnedDestinationPosition   InventoryPosition?                            @relation("ReconciliationDestinationPosition", fields: [returnedDestinationPositionId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  returnedPhysicalEffect        InventoryPhysicalEffect?                      @relation("ReconciliationReturnedEffect", fields: [returnedPhysicalEffectId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  usedPhysicalEffect            InventoryPhysicalEffect?                      @relation("ReconciliationUsedEffect", fields: [usedPhysicalEffectId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  equipmentCustody              EquipmentAssetCustody?                        @relation(fields: [equipmentCustodyId, companyId, assetId], references: [id, companyId, equipmentAssetId], onDelete: Restrict, onUpdate: Restrict)
  asset                         EquipmentAsset?                               @relation(fields: [assetId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  assignment                    HealthcareEquipmentAssignment?                @relation(fields: [assignmentId, companyId, caseId, assetId], references: [id, companyId, caseId, equipmentAssetId], onDelete: Restrict, onUpdate: Restrict)
  closePhysicalEvent            EquipmentAssetPhysicalEvent?                  @relation(fields: [closePhysicalEventId, companyId, assetId], references: [id, companyId, equipmentAssetId], onDelete: Restrict, onUpdate: Restrict)
  createdBy                     User                                          @relation("ReconciliationItemCreatedBy", fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  excludedBy                    User?                                         @relation("ReconciliationItemExcludedBy", fields: [excludedById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  audit                         HealthcareCaseReconciliationAudit[]

  @@unique([id, companyId, reconciliationId], map: "Reconciliation_item_audit_key")
  @@index([companyId, reconciliationId, createdAt, id], map: "Reconciliation_item_list_idx")
}

model HealthcareCaseReconciliationAudit {
  id                   String                                     @id @default(uuid())
  companyId            String
  reconciliationId     String
  reconciliationItemId String?
  operation            HealthcareCaseReconciliationAuditOperation
  actorId              String
  createdAt            DateTime                                   @default(now())
  revisionBefore       Int?
  revisionAfter        Int
  change               Json                                       @db.JsonB
  reconciliation       HealthcareCaseReconciliation               @relation(fields: [reconciliationId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  reconciliationItem   HealthcareCaseReconciliationItem?          @relation(fields: [reconciliationItemId, companyId, reconciliationId], references: [id, companyId, reconciliationId], onDelete: Restrict, onUpdate: Restrict)
  actor                User                                       @relation(fields: [actorId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, reconciliationId, revisionAfter], map: "Reconciliation_audit_revision_key")
  @@index([companyId, reconciliationId, createdAt, id], map: "Reconciliation_audit_list_idx")
}

enum HealthcareCaseDispatchCorrectionKind {
  NO_PHYSICAL_HANDOFF
}

enum HealthcareCaseDispatchCorrectionStatus {
  CONFIRMED
}

// SQL requires a complete sealed witness at commit. Null snapshots/evidence are
// transaction-local staging only; seal the root last. No application writer yet.
model HealthcareCaseDispatchCorrection {
  // Internal top-level transaction identity, checked by SQL; not a public state.
  creationTransactionId Unsupported("xid8")                    @default(dbgenerated("pg_current_xact_id()"))
  id                    String                                 @id @default(uuid())
  companyId             String
  caseId                String
  caseKitId             String
  dispatchId            String
  kind                  HealthcareCaseDispatchCorrectionKind   @default(NO_PHYSICAL_HANDOFF)
  status                HealthcareCaseDispatchCorrectionStatus @default(CONFIRMED)
  reason                String                                 @db.VarChar(1000)
  attestedNoHandoff     Boolean
  confirmedById         String
  confirmedAt           DateTime                               @default(now())
  hashVersion           Int                                    @default(1)
  requestHash           String                                 @db.Char(64)
  idempotencyRecordId   String                                 @unique(map: "DispatchCorrection_idempotency_key")
  snapshotVersion       Int                                    @default(1)
  snapshot              Json?                                  @db.JsonB
  company               Company                                @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  healthcareCase        HealthcareCase                         @relation(fields: [caseId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  dispatch              HealthcareCaseDispatch                 @relation(fields: [dispatchId, companyId, caseId, caseKitId], references: [id, companyId, caseId, caseKitId], onDelete: Restrict, onUpdate: Restrict)
  confirmedBy           User                                   @relation("DispatchCorrectionActor", fields: [confirmedById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  idempotencyRecord     IdempotencyRecord                      @relation(fields: [idempotencyRecordId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  items                 HealthcareCaseDispatchCorrectionItem[]

  @@unique([companyId, dispatchId], map: "DispatchCorrection_dispatch_key")
  @@unique([dispatchId, companyId, caseId, caseKitId], map: "DispatchCorrection_dispatch_relation_key")
  @@unique([idempotencyRecordId, companyId], map: "DispatchCorrection_idempotency_relation_key")
  @@unique([id, companyId, dispatchId], map: "DispatchCorrection_parent_key")
  @@index([companyId, caseId, confirmedAt, id], map: "DispatchCorrection_case_idx")
  @@index([creationTransactionId], map: "DispatchCorrection_creation_transaction_idx")
}

model HealthcareCaseDispatchCorrectionItem {
  id                       String                           @id @default(uuid())
  companyId                String
  correctionId             String
  dispatchId               String
  sourceDispatchItemId     String
  type                     HealthcareCaseDispatchItemType
  quantity                 Int?
  originalPhysicalEffectId String?
  sourceCustodyPositionId  String?
  compensatingEffectId     String?
  destinationPositionId    String?
  assetId                  String?
  equipmentCustodyId       String?
  openPhysicalEventId      String?
  closePhysicalEventId     String?                          @unique(map: "DispatchCorrectionItem_close_key")
  snapshot                 Json?                            @db.JsonB
  correction               HealthcareCaseDispatchCorrection @relation(fields: [correctionId, companyId, dispatchId], references: [id, companyId, dispatchId], onDelete: Restrict, onUpdate: Restrict)
  sourceDispatchItem       HealthcareCaseDispatchItem       @relation(fields: [sourceDispatchItemId, companyId, dispatchId], references: [id, companyId, dispatchId], onDelete: Restrict, onUpdate: Restrict)
  originalPhysicalEffect   InventoryPhysicalEffect?         @relation("CorrectionOriginalEffect", fields: [originalPhysicalEffectId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  sourceCustodyPosition    InventoryPosition?               @relation("CorrectionSourcePosition", fields: [sourceCustodyPositionId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  compensatingEffect       InventoryPhysicalEffect?         @relation("CorrectionCompensatingEffect", fields: [compensatingEffectId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  destinationPosition      InventoryPosition?               @relation("CorrectionDestinationPosition", fields: [destinationPositionId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  asset                    EquipmentAsset?                  @relation(fields: [assetId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  equipmentCustody         EquipmentAssetCustody?           @relation(fields: [equipmentCustodyId, companyId, assetId], references: [id, companyId, equipmentAssetId], onDelete: Restrict, onUpdate: Restrict)
  openPhysicalEvent        EquipmentAssetPhysicalEvent?     @relation("CorrectionOpenEvent", fields: [openPhysicalEventId, companyId, assetId], references: [id, companyId, equipmentAssetId], onDelete: Restrict, onUpdate: Restrict)
  closePhysicalEvent       EquipmentAssetPhysicalEvent?     @relation("CorrectionCloseEvent", fields: [closePhysicalEventId, companyId, assetId], references: [id, companyId, equipmentAssetId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, correctionId, sourceDispatchItemId], map: "DispatchCorrectionItem_source_key")
  @@index([companyId, sourceDispatchItemId], map: "DispatchCorrectionItem_source_idx")
}
