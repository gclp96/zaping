model SupplierDocument {
  id                         String  @id @default(uuid())
  companyId                  String
  supplierId                 String
  type                       SupplierDocumentType
  series                     String? @db.VarChar(80)
  number                     String  @db.VarChar(160)
  normalizedSeries           String  @default("") @db.VarChar(80)
  normalizedNumber           String  @db.VarChar(160)
  identityOccurrence         Int     @default(1)
  documentDate               DateTime @db.Date
  cfdiUuid                   String? @db.Uuid
  issuerRfc                  String? @db.VarChar(13)
  receiverRfc                String? @db.VarChar(13)
  currency                   String? @db.VarChar(3)

  subtotalAmount             Decimal? @db.Decimal(18, 2)
  discountAmount             Decimal? @db.Decimal(18, 2)
  freightAmount              Decimal? @db.Decimal(18, 2)
  ivaAmount                  Decimal? @db.Decimal(18, 2)
  withholdingAmount          Decimal? @db.Decimal(18, 2)
  totalAmount                Decimal? @db.Decimal(18, 2)
  goodsNetAmount             Decimal? @db.Decimal(18, 2)
  basisStatus                SupplierDocumentBasisStatus @default(PENDING_REVIEW)
  status                     SupplierDocumentStatus @default(ACTIVE)
  revision                   Int @default(0)
  cancellationSource         SupplierDocumentCancellationSource?
  cancellationReason         String? @db.VarChar(1000)
  cancelledAt                DateTime?
  cancelledById              String?
  replacedByDocumentId       String?

  exceptionBasedOnDocumentId String?
  exceptionReason            String? @db.VarChar(1000)
  exceptionEvidenceReference String? @db.VarChar(1000)
  exceptionReviewedById      String?
  exceptionReviewedAt        DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplier Supplier @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("SupplierDocumentCreatedBy", fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  exceptionReviewer User? @relation("SupplierDocumentExceptionReviewer", fields: [exceptionReviewedById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  exceptionBase SupplierDocument? @relation("SupplierDocumentExceptionBase", fields: [exceptionBasedOnDocumentId, companyId, supplierId], references: [id, companyId, supplierId], onDelete: Restrict, onUpdate: Restrict)
  exceptions SupplierDocument[] @relation("SupplierDocumentExceptionBase")
  taxBreakdowns SupplierDocumentTaxBreakdown[]
  audits SupplierDocumentAudit[]
  allocations PurchaseReceiptDocument[]
  receiptLinks PurchaseReceiptSupplierDocumentLink[]
  attachments SupplierDocumentAttachment[]
  uploadReservations SupplierAttachmentUploadReservation[]
  cancelledBy User? @relation("SupplierDocumentCancelledBy", fields: [cancelledById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  replacedBy SupplierDocument? @relation("SupplierDocumentReplacement", fields: [replacedByDocumentId, companyId, supplierId], references: [id, companyId, supplierId], onDelete: Restrict, onUpdate: Restrict)
  replaces SupplierDocument[] @relation("SupplierDocumentReplacement")

  @@unique([id, companyId])
  @@unique([id, companyId, supplierId])
  @@unique([companyId, cfdiUuid], map: "SupplierDocument_company_cfdi_uuid_key")
  @@unique([companyId, supplierId, type, normalizedSeries, normalizedNumber, identityOccurrence], map: "SupplierDocument_commercial_occurrence_key")
  @@index([companyId, supplierId, type, normalizedSeries, normalizedNumber], map: "SupplierDocument_identity_search_idx")
  @@index([companyId, supplierId, documentDate])
  @@index([companyId, replacedByDocumentId])
}

