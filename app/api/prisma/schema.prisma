  actor          User                                 @relation(fields: [actorId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, dispatchId, revisionAfter])
  @@index([companyId, dispatchId, createdAt, id])
}

enum HealthcareCaseReconciliationStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum HealthcareCaseReconciliationItemType {
  MATERIAL
  EQUIPMENT
}

enum HealthcareCaseReconciliationItemLifecycle {
  ACTIVE
  EXCLUDED
}

enum HealthcareCaseReconciliationEquipmentOutcome {
  RETURNED
  UNRESOLVED
}

enum HealthcareCaseReconciliationAuditOperation {
  CREATE
  ITEM_ADD
  OUTCOME_SET
  ITEM_EXCLUDE
  CONFIRM
  CANCEL
}

model HealthcareCaseReconciliation {
  id                    String                              @id @default(uuid())
  companyId             String
  caseId                String
  dispatchId            String
  caseKitId             String
  status                HealthcareCaseReconciliationStatus  @default(DRAFT)
  revision              Int                                 @default(0)
  createdById           String
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt
  confirmedFromRevision Int?
  confirmedById         String?
  confirmedAt           DateTime?
  cancelledById         String?
  cancelledAt           DateTime?
  cancellationReason    String?                             @db.VarChar(1000)
  observation           String?                             @db.VarChar(1000)
  snapshotVersion       Int?
  snapshot              Json?                               @db.JsonB
  company               Company                             @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  healthcareCase        HealthcareCase                      @relation(fields: [caseId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  dispatch              HealthcareCaseDispatch              @relation(fields: [dispatchId, companyId, caseId, caseKitId], references: [id, companyId, caseId, caseKitId], onDelete: Restrict, onUpdate: Restrict)
  caseKit               HealthcareCaseKit                   @relation(fields: [caseKitId, companyId, caseId], references: [id, companyId, caseId], onDelete: Restrict, onUpdate: Restrict)
  createdBy             User                                @relation("ReconciliationCreatedBy", fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  confirmedBy           User?                               @relation("ReconciliationConfirmedBy", fields: [confirmedById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  cancelledBy           User?                               @relation("ReconciliationCancelledBy", fields: [cancelledById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  items                 HealthcareCaseReconciliationItem[]
  audit                 HealthcareCaseReconciliationAudit[]

  @@unique([id, companyId], map: "Reconciliation_identity_key")
  @@unique([id, companyId, caseId, dispatchId], map: "Reconciliation_parent_key")
  @@index([companyId, caseId, createdAt, id], map: "Reconciliation_case_list_idx")
  @@index([companyId, caseId, status, createdAt, id], map: "Reconciliation_status_list_idx")
  @@index([companyId, caseId, dispatchId, createdAt, id], map: "Reconciliation_dispatch_list_idx")
}

model HealthcareCaseReconciliationItem {
