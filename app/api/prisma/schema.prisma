  purchase Purchase @relation(fields: [purchaseId, companyId, supplierId], references: [id, companyId, supplierId], onDelete: Restrict, onUpdate: Restrict)
  receipt PurchaseReceipt @relation(fields: [receiptId, companyId, purchaseId], references: [id, companyId, purchaseId], onDelete: Restrict, onUpdate: Restrict)
  document SupplierDocument @relation(fields: [documentId, companyId, supplierId], references: [id, companyId, supplierId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("SupplierDocumentAllocationCreator", fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, documentId, receiptId], map: "PurchaseReceiptDocument_pair_key")
  @@index([companyId, receiptId, isActive])
  @@index([companyId, documentId, isActive])
}

/// R2A-02: append-only snapshot of approval for a receipt including multiple documents.
model PurchaseReceiptReconciliationApproval {
  id                      String @id @default(uuid())
  companyId               String
  supplierId              String
  purchaseId              String
  receiptId               String
  currency                String @db.VarChar(3)
  receiptNetAmount        Decimal @db.Decimal(18, 2)
  allocatedTotalAmount    Decimal @db.Decimal(18, 2)
  differenceAmount        Decimal @db.Decimal(18, 2)
  allocationSnapshotHash  String @db.VarChar(64)
  allocationSnapshot      Json @db.JsonB
  reason                  String @db.VarChar(1000)
  approvedById            String
  createdAt               DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplier Supplier @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  purchase Purchase @relation(fields: [purchaseId, companyId, supplierId], references: [id, companyId, supplierId], onDelete: Restrict, onUpdate: Restrict)
  receipt PurchaseReceipt @relation(fields: [receiptId, companyId, purchaseId], references: [id, companyId, purchaseId], onDelete: Restrict, onUpdate: Restrict)
  approvedBy User @relation("SupplierDocumentApprovalActor", fields: [approvedById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  @@index([companyId, receiptId, createdAt, id])
  @@unique([companyId, receiptId, allocationSnapshotHash], map: "PurchaseReceiptApproval_snapshot_key")
}


/// Nonmonetary document link. Financial allocations remain in PurchaseReceiptDocument.
model PurchaseReceiptSupplierDocumentLink {
  id          String    @id @default(uuid())
  companyId   String
  purchaseId  String
  supplierId  String
  receiptId   String
  documentId  String
  createdById String
  createdAt   DateTime  @default(now())
  removedById String?
  removedAt   DateTime?
  reason      String?   @db.VarChar(1000)

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchase  Purchase        @relation(fields: [purchaseId, companyId, supplierId], references: [id, companyId, supplierId], onDelete: Restrict, onUpdate: Restrict)
  receipt   PurchaseReceipt @relation(fields: [receiptId, companyId, purchaseId], references: [id, companyId, purchaseId], onDelete: Restrict, onUpdate: Restrict)
  document  SupplierDocument @relation(fields: [documentId, companyId, supplierId], references: [id, companyId, supplierId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User            @relation("ReceiptDocumentLinkCreatedBy", fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  removedBy User?           @relation("ReceiptDocumentLinkRemovedBy", fields: [removedById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  // One active link per pair, enforced by a partial unique index in migration SQL.
  // Historical removed rows remain immutable for auditability.
  @@index([companyId, receiptId, documentId])
  @@index([companyId, documentId])
}

/// UX-PDOC-01B: private object metadata. Never stores bytes or a public URL.
/// No attachment is downloadable until an external scanner marks it AVAILABLE.
enum SupplierAttachmentUploadReservationStatus {
  RESERVED
  RECONCILE_REQUIRED
  REGISTERED
  RELEASED_VERIFIED_EMPTY
}

/**
 * Durable ledger for in-flight uploads. Reservations are NOT attachments.
 * The registered attachment table remains scanner-gated and immutable.
 */
model SupplierAttachmentUploadReservation {
  id            String @id @default(uuid())
  companyId     String
  documentId    String
  createdById   String
  requestKey    String @db.VarChar(128)
  quarantineKey String @db.VarChar(300)
  originalName  String @db.VarChar(255)
  contentType   String @db.VarChar(32)
  sizeBytes     Int
  sha256        String @db.VarChar(64)
  status        SupplierAttachmentUploadReservationStatus @default(RESERVED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reconcileEvents SupplierAttachmentReconcileEvent[]
  scanAttempts SupplierAttachmentScanAttempt[]
  scanJobs SupplierAttachmentScanJob[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  document SupplierDocument @relation(fields: [documentId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("SupplierAttachmentUploadReservationActor", fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, companyId], map: "SAR_id_company_key")
  @@unique([companyId, documentId, requestKey], map: "SAR_company_document_request_key")
  @@unique([companyId, quarantineKey], map: "SAR_company_quarantine_key")
  @@index([companyId, documentId, status, createdAt], map: "SAR_company_document_status_created")
}

enum SupplierAttachmentReconcileAction {
  NEEDS_REVIEW
  QUARANTINE_VERIFIED
}

model SupplierAttachmentReconcileEvent {
  id            String @id @default(uuid())
  companyId     String
  reservationId String
  action        SupplierAttachmentReconcileAction
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reservation SupplierAttachmentUploadReservation @relation(fields: [reservationId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  @@index([companyId, reservationId, createdAt], map: "SARE_company_reservation_created_idx")
}

model SupplierDocumentAttachment {
  id            String @id @default(uuid())
  companyId     String
  documentId    String
  storageKey    String @db.VarChar(300)
  originalName  String @db.VarChar(255)
  contentType   String @db.VarChar(32)
  sizeBytes     Int
  sha256        String @db.VarChar(64)
  status        SupplierDocumentAttachmentStatus @default(PENDING_SCAN)
  scanEngine    String? @db.VarChar(80)
  scannedAt     DateTime?
  rejectionReason String? @db.VarChar(1000)
  uploadedById  String
  createdAt     DateTime @default(now())
  removedById   String?
  removedAt     DateTime?
  scanAttempts SupplierAttachmentScanAttempt[]
  scanJobs SupplierAttachmentScanJob[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  document SupplierDocument @relation(fields: [documentId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy User @relation("SupplierAttachmentUploadedBy", fields: [uploadedById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  removedBy User? @relation("SupplierAttachmentRemovedBy", fields: [removedById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, companyId], map: "SDATT_id_company_key")
  @@unique([companyId, storageKey])
  @@index([companyId, documentId, status, createdAt])
}

/// B3d5a append-only, UNTRUSTED scan observations.
/// No record here may authorize AVAILABLE or REJECTED until later signed
/// worker attestation + private-object promotion gates are implemented.
model SupplierAttachmentScanAttempt {
  id               String @id @default(uuid())
  companyId        String
  attachmentId     String
  reservationId    String
  requestNonce     String @db.Uuid
  contentSizeBytes Int
  contentSha256    String @db.VarChar(64)
  verdict          SupplierAttachmentScanVerdict
  engineVersion    String? @db.VarChar(80)
  databaseVersion  Int?
  databaseBuiltAt  DateTime?
  policyVersion    String? @db.VarChar(80)
  workerIdentity   String? @db.VarChar(128)
  failureCode      String? @db.VarChar(80)
  createdAt        DateTime @default(now())
  signedReceipt    SupplierAttachmentSignedEvidenceReceipt?

  attachment SupplierDocumentAttachment @relation(fields: [attachmentId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  reservation SupplierAttachmentUploadReservation @relation(fields: [reservationId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, companyId, requestNonce], map: "SASA_id_company_nonce_key")
  @@unique([companyId, requestNonce], map: "SASA_company_nonce_key")
  @@index([companyId, attachmentId, createdAt], map: "SASA_company_attachment_created_idx")
}


/// B3d5b3a: append-only receipt of UNTRUSTED signed claims.
/// A stored signature has NOT been verified by PostgreSQL, and is never a
/// clean-file release authorization. Only future restricted gateway services
/// may verify and persist authenticated scanner evidence.
model SupplierAttachmentSignedEvidenceReceipt {
  id           String @id @default(uuid())
  companyId    String
  attemptId    String @unique(map: "SASER_attempt_key")
  requestNonce String @db.Uuid
  signingKeyId String @db.VarChar(64)
  signature    String @db.VarChar(86)
  signedClaims Json @db.JsonB
  recordedAt   DateTime @default(now())

  verification SupplierAttachmentVerifiedScanEvidence?
  attempt SupplierAttachmentScanAttempt @relation(fields: [attemptId, companyId, requestNonce], references: [id, companyId, requestNonce], onDelete: Restrict, onUpdate: Restrict)

  @@unique([attemptId, companyId, requestNonce], map: "SASER_attempt_company_nonce_key")
  @@unique([companyId, requestNonce], map: "SASER_company_nonce_key")
  @@index([companyId, recordedAt], map: "SASER_company_recorded_idx")
}


/// B3d5b3b: a DB-issued, immutable, tenant-scoped challenge bound to one
/// registered upload. CONSUMED only means a matching untrusted receipt was
/// durably recorded; it does NOT certify signature validity or scan safety.
/// Only owner-run lab functions can issue/consume until B3d5b3c role review.
model SupplierAttachmentScanJob {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String
  documentId       String
  attachmentId     String
  reservationId    String
  requestNonce     String @unique(map: "SASJ_nonce_key") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quarantineKey    String @db.VarChar(300)
  contentSizeBytes Int
  contentSha256    String @db.VarChar(64)
  status           SupplierAttachmentScanJobStatus @default(ISSUED)
  issuedAt         DateTime @default(now())
  expiresAt        DateTime
  consumedAt       DateTime?

  attachment SupplierDocumentAttachment @relation(fields: [attachmentId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  reservation SupplierAttachmentUploadReservation @relation(fields: [reservationId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  verification SupplierAttachmentVerifiedScanEvidence?

  @@index([companyId, attachmentId, status, expiresAt], map: "SASJ_company_attachment_status_idx")
}


/// B3d5b3c1: verifier-gateway audit marker, NOT authorization for AVAILABLE.
/// A valid Ed25519 signature is checked in the isolated gateway transaction,
/// but the database owner can still forge rows. Production DB role separation
/// and signed scanner provenance are required before using this marker.
model SupplierAttachmentVerifiedScanEvidence {
  id              String @id @default(uuid())
  jobId           String @unique(map: "SAVSE_job_key") @db.Uuid
  receiptId       String @unique(map: "SAVSE_receipt_key")
  companyId       String
  requestNonce    String @unique(map: "SAVSE_nonce_key") @db.Uuid
  signingKeyId    String @db.VarChar(64)
  signatureSha256 String @db.VarChar(64)
  verifiedAt      DateTime @default(now())

  job SupplierAttachmentScanJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receipt SupplierAttachmentSignedEvidenceReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([companyId, verifiedAt], map: "SAVSE_company_verified_idx")
}
